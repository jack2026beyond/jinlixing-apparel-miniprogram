/* pages/index/index.wxss 首页样式 */

.page {
  padding-bottom: 40rpx;
}

/* 品牌栏 */
.brand-bar {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx 20rpx;
  background: linear-gradient(135deg, #1a3f70, #204e8a);
}
.brand-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #fff;
}
.brand-info {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}
.brand-name {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
.brand-slogan {
  margin-top: 8rpx;
  color: #c9dcf0;
  font-size: 22rpx;
}

/* 轮播 */
.banner-wrap {
  padding: 0 24rpx;
  margin-top: -8rpx;
}
.banner {
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.banner-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

/* 服务亮点 */
.highlights {
  display: flex;
  justify-content: space-around;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
}
.highlight {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.highlight-icon {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf1fa;
  color: #204e8a;
  font-size: 24rpx;
  font-weight: 700;
}
.highlight-text {
  margin-top: 10rpx;
  color: #4a5159;
  font-size: 22rpx;
}

/* section 头部 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* 分类网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
}
.category-item {
  display: flex;
  width: 20%;
  flex-direction: column;
  align-items: center;
}
.category-img-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.category-img {
  width: 100%;
  height: 100%;
}
.category-name {
  margin-top: 12rpx;
  color: #1f2329;
  font-size: 24rpx;
  font-weight: 600;
}
.category-desc {
  margin-top: 4rpx;
  color: #98a0aa;
  font-size: 20rpx;
}

/* 热门商品 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product-card {
  width: 48%;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.05);
}
.product-img {
  width: 100%;
  height: 300rpx;
  display: block;
}
.product-info {
  padding: 18rpx;
}
.product-name {
  display: block;
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 700;
}
.product-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a929c;
  font-size: 22rpx;
  line-height: 1.4;
  height: 60rpx;
}
.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.product-price {
  color: #e8833a;
  font-size: 28rpx;
  font-weight: 700;
}
.product-moq {
  color: #98a0aa;
  font-size: 20rpx;
}

/* 定制流程 */
.flow-list {
  display: flex;
  justify-content: space-between;
}
.flow-item {
  display: flex;
  width: 25%;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.flow-num {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #204e8a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.flow-title {
  margin-top: 12rpx;
  color: #1f2329;
  font-size: 24rpx;
  font-weight: 600;
}
.flow-desc {
  margin-top: 4rpx;
  color: #98a0aa;
  font-size: 20rpx;
  text-align: center;
}

/* 联系我们入口 */
.contact-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1a3f70, #2c6096);
}
.contact-left {
  display: flex;
  flex-direction: column;
}
.contact-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}
.contact-sub {
  margin-top: 10rpx;
  color: #c9dcf0;
  font-size: 22rpx;
}
.contact-btn {
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  background: #e8833a;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.footer {
  padding: 20rpx 0 40rpx;
  text-align: center;
  color: #b0b6bd;
  font-size: 20rpx;
}
