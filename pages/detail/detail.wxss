/* pages/detail/detail.wxss 商品详情页样式 */

.page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.detail-img {
  width: 100%;
  height: 560rpx;
  display: block;
}

.detail-body {
  padding: 32rpx 28rpx 28rpx;
  background: #fff;
}
.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.name {
  color: #1f2329;
  font-size: 40rpx;
  font-weight: 700;
}
.price {
  color: #e8833a;
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
}
.desc {
  display: block;
  margin-top: 14rpx;
  color: #8a929c;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 核心参数 */
.meta-row {
  display: flex;
  margin-top: 28rpx;
  padding: 24rpx 0;
  border-top: 2rpx solid #eceff2;
  border-bottom: 2rpx solid #eceff2;
}
.meta-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}
.meta-label {
  color: #98a0aa;
  font-size: 22rpx;
}
.meta-value {
  margin-top: 8rpx;
  color: #1f2329;
  font-size: 26rpx;
  font-weight: 600;
}

/* 规格/尺码选项 */
.section-head {
  margin-bottom: 20rpx;
}
.option-list {
  display: flex;
  flex-wrap: wrap;
}
.option {
  padding: 14rpx 30rpx;
  margin: 0 20rpx 20rpx 0;
  border-radius: 10rpx;
  background: #f2f3f5;
  color: #4a5159;
  font-size: 26rpx;
}
.option.selected {
  background: #eaf1fa;
  color: #204e8a;
  font-weight: 700;
  border: 2rpx solid #204e8a;
}

/* 报价说明 */
.detail-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}
.dot {
  color: #e8833a;
  font-size: 28rpx;
  margin-right: 12rpx;
  line-height: 1.4;
}
.detail-text {
  flex: 1;
  color: #4a5159;
  font-size: 26rpx;
  line-height: 1.6;
}
.price-note {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #eceff2;
  color: #a0a6ae;
  font-size: 22rpx;
  line-height: 1.5;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(31, 35, 41, 0.06);
}
.bar-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}
.bar-icon {
  font-size: 36rpx;
  line-height: 1;
}
.bar-text {
  margin-top: 6rpx;
  color: #646a73;
  font-size: 20rpx;
}
.bar-inquiry {
  flex: 1;
  margin-left: 16rpx;
  background: #204e8a;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
.bar-inquiry::after {
  border: none;
}
