/* pages/inquiry/inquiry.wxss 询价表单页样式 */

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 表单说明 */
.intro {
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #1a3f70, #204e8a);
}
.intro-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
}
.intro-sub {
  margin-top: 12rpx;
  color: #c9dcf0;
  font-size: 26rpx;
}

/* 表单主体 */
.form {
  margin: 24rpx;
  padding: 8rpx 28rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
}

.form-item {
  padding: 28rpx 0;
  border-bottom: 2rpx solid #eceff2;
}
.form-item:last-of-type {
  border-bottom: none;
}

.label {
  display: block;
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 600;
}
.required {
  color: #e8833a;
}
.label-hint {
  display: block;
  margin-top: 8rpx;
  color: #a0a6ae;
  font-size: 22rpx;
}

.input,
.picker,
.textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  color: #1f2329;
  font-size: 28rpx;
}
.picker {
  line-height: 1.4;
}
.picker.placeholder {
  color: #b0b6bd;
}
.textarea {
  min-height: 160rpx;
  line-height: 1.6;
}

.field-tip {
  display: block;
  margin-top: 12rpx;
  color: #e8833a;
  font-size: 22rpx;
}
.error {
  display: block;
  margin-top: 12rpx;
  color: #e34d59;
  font-size: 24rpx;
}

/* 图片上传 */
.upload-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}
.upload-item,
.upload-add {
  width: 160rpx;
  height: 160rpx;
  margin: 0 20rpx 20rpx 0;
  border-radius: 12rpx;
  position: relative;
}
.upload-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.upload-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
}
.upload-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  border: 2rpx dashed #c8cdd3;
}
.add-plus {
  color: #8a929c;
  font-size: 56rpx;
  line-height: 1;
}
.add-text {
  margin-top: 8rpx;
  color: #8a929c;
  font-size: 22rpx;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 36rpx;
  background: #204e8a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  height: 92rpx;
  line-height: 92rpx;
}
.submit-btn::after {
  border: none;
}

/* 提示 */
.note {
  margin: 24rpx 32rpx 0;
  color: #a0a6ae;
  font-size: 22rpx;
  line-height: 1.6;
}
