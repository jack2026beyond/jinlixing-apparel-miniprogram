<!--
  pages/inquiry/inquiry.wxml
  询价表单页：姓名 / 电话 / 数量 / 款式 / 上传图案Logo / 备注
  提交后跳转到结果页展示提交成功与编号
-->
<view class="page">
  <!-- 表单说明 -->
  <view class="intro">
    <text class="intro-title">定制询价单</text>
    <text class="intro-sub">填写以下信息，我们将尽快与您联系报价</text>
  </view>

  <form class="form" bindsubmit="onSubmit" report-submit="{{false}}">
    <!-- 姓名 -->
    <view class="form-item">
      <text class="label">联系人姓名 <text class="required">*</text></text>
      <input
        class="input"
        name="name"
        data-field="name"
        placeholder="请输入您的姓名"
        value="{{form.name}}"
        bindinput="onInput" />
      <text class="error" wx:if="{{errors.name}}">{{errors.name}}</text>
    </view>

    <!-- 电话 -->
    <view class="form-item">
      <text class="label">联系电话 <text class="required">*</text></text>
      <input
        class="input"
        type="number"
        name="phone"
        data-field="phone"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{form.phone}}"
        bindinput="onInput" />
      <text class="error" wx:if="{{errors.phone}}">{{errors.phone}}</text>
    </view>

    <!-- 数量 -->
    <view class="form-item">
      <text class="label">定制数量（件） <text class="required">*</text></text>
      <input
        class="input"
        type="number"
        name="quantity"
        data-field="quantity"
        placeholder="请输入预计定制数量"
        value="{{form.quantity}}"
        bindinput="onInput" />
      <text class="field-tip" wx:if="{{moqTip}}">该商品起订 {{moqTip}} 件</text>
      <text class="error" wx:if="{{errors.quantity}}">{{errors.quantity}}</text>
    </view>

    <!-- 款式 -->
    <view class="form-item">
      <text class="label">款式 / 品类 <text class="required">*</text></text>
      <picker name="style" mode="selector" range="{{styleOptions}}" value="{{styleIndex}}" bindchange="onStyleChange">
        <view class="picker {{form.style ? '' : 'placeholder'}}">
          {{form.style || '请选择款式品类'}}
        </view>
      </picker>
      <text class="error" wx:if="{{errors.style}}">{{errors.style}}</text>
    </view>

    <!-- 上传图案 Logo -->
    <view class="form-item">
      <text class="label">图案 / Logo</text>
      <text class="label-hint">上传设计图或参考图，支持 jpg/png，最多 3 张</text>
      <view class="upload-list">
        <view class="upload-item" wx:for="{{images}}" wx:key="*this">
          <image class="upload-img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" />
          <view class="upload-del" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
        <view class="upload-add" wx:if="{{images.length < 3}}" bindtap="chooseImage">
          <text class="add-plus">+</text>
          <text class="add-text">上传图片</text>
        </view>
      </view>
    </view>

    <!-- 补充说明 -->
    <view class="form-item">
      <text class="label">补充说明</text>
      <textarea
        class="textarea"
        name="remark"
        data-field="remark"
        placeholder="如面料要求、颜色、交货时间等（选填）"
        value="{{form.remark}}"
        bindinput="onInput"
        maxlength="300" />
    </view>

    <!-- 提交按钮 -->
    <button class="submit-btn" form-type="submit" loading="{{submitting}}" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交询价单'}}
    </button>
  </form>

  <!-- 提示 -->
  <view class="note">
    <text>温馨提示：当前为演示版本，询价数据保存在本机，商家暂不能远程接收。正式使用请接入云端存储。</text>
  </view>
</view>
