/**
 * app.wxss
 * 全局样式：品牌色变量、通用卡片/按钮/标题等，各页面可直接复用
 */
page {
  min-height: 100%;
  background: #f5f7fa;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  /* 品牌主色，修改这里可统一调整全站色调 */
  --brand: #204e8a;
  --brand-dark: #1a3f70;
  --brand-light: #eaf1fa;
  --accent: #e8833a;
  --text: #1f2329;
  --text-sub: #646a73;
  --line: #eceff2;
}

button {
  border-radius: 12rpx;
}

/* 通用：区块标题 */
.section {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

/* 标题左侧的小色条 */
.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  margin-right: 16rpx;
  border-radius: 4rpx;
  background: var(--accent);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 通用：主按钮 */
.btn-primary {
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary::after {
  border: none;
}

/* 通用：空态 */
.empty-tip {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
}
